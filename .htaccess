Options -Indexes
RewriteEngine On

# Keep direct requests to legacy PHP scripts and existing assets unchanged.
RewriteRule ^commun/(.+\.(?:png|jpe?g|gif|webp|svg|bmp|tiff|ico))$ assets/images/community/$1 [NC,L]
RewriteRule ^(?:quiz/)?image-profil/image-personaliser/(.+)$ uploads/avatars/$1 [L]
RewriteRule ^(?:quiz/)?image-profil/(.+\.(?:png|jpe?g|gif|webp|svg|bmp|tiff|ico))$ assets/images/avatars/presets/$1 [NC,L]
RewriteRule ^(?:quiz/)?quiz_perso/(.+)$ uploads/quizzes/$1 [L]
RewriteRule ^quiz/uploads/quizzes/(.+)$ uploads/quizzes/$1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]